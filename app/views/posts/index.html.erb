<div class="bkg-img">
  <h1 class="text-white ps-2 ps-md-5 py-4 pb-lg-5">投稿一覧</h1>
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-11 col-lg-10 col-xl-9 col-xxl-8">
        <%= render partial: 'layouts/flash' %>
        <div class="row justify-content-center mb-5">
          <% if logged_in? %>
            <%= link_to "新規録音/投稿", new_post_path, class: "btn btn-custom rounded-pill col-6 col-sm-4 py-3 px-1 me-sm-5 text-white border border-dark fw-bold fs-lg-larger", type: "button" %>
            <div class="w-100 d-sm-none my-2"></div>
            <%= link_to "セッションする", new_post_path(audio_flg: 'default_audio'), class: "btn btn-custom rounded-pill col-6 col-sm-4 py-3 ms-lg-5 text-white border border-dark fw-bold fs-lg-larger", type: "button" %>
          <% end %>
        </div>
        <%# カードレイアウト実装 8/17 %>
        <div class="row row-cols-md-2 gy-5 g-md-5 pb-5">
          <% @posts.each do |post| %>
            <div class="col">
              <div class="card bg-color-post-card h-100">
                <div class="card-header d-flex justify-content-between mx-2 ps-1">
                  <div class= "fw-bold">
                    <%# FIXME: 画像ファイルが正しく読みこまえれない場合一、時的にデフォルトアバターを表示させる 23/12/24 %>
                    <%#= image_tag("#{post.user.avatar}", class: 'rounded-circle', size: '40x40') %>
                    <%= avatar_image_tag(post.user, 'rounded-circle border border-secondary', '40x40') %>
                    <%= post.user.name %>
                  </div>
                  <% unless @root_collab_post %>
                      <%= link_to 'セッションする', new_post_path(audio_flg: "posted_audio", collab_post_id: post.id), type: "button", class: "btn btn-custom rounded-pill text-white border border-dark fw-bold fs-small fs-lg-smaller py-2 mb-1 ms-1" %>
                  <% end %>
                </div>

                <div class="card-body pe-sm-5 pe-md-3 px-lg-4">
                  <h2 class="card-title fw-bold fs-5"><%= post.title %></h2>
                  <%# post-text-ellipsis.jsによりテキスト省略を判定させる %>
                  <a class="js-post-card-text link-dark link-underline link-underline-opacity-0" href="#textEllipsis">
                    <p class="card-text text-truncate"><%= post.body %></p>
                  </a>

                  <div class="mt-4 mb-2">
                    <%= render "layouts/guest_tutorial/audio_slider", slider_type: "audio", slider_size: "100", audio_blob_url: post.voice %>
                  </div>
                  <%# if post.voice.attached? %>
                    <%#= audio_tag(url_for(post.voice), controls: true, class: "w-100") %>
                  <%# end %>
                </div>

                <div class="card-footer d-flex flex-row justify-content-between">
                  <div class="mt-2">
                    <a href="#" class="fs-small fs-xl-medium me-2">コメント 10件</a>
                    <a href="#" class="fs-small fs-xl-medium">オレ〜!! 20件</a>
                  </div>
                  <div class="card-offcanvas">
                    <button class="btn btn-link" type="button" data-bs-toggle="offcanvas" data-bs-target="#offcanvasBottom<%= "#{post.id}" %>" aria-controls="offcanvasBottom<%= "#{post.id}" %>">
                      <%= image_pack_tag "media/images/icon/meatballs-menu.png", size: "30x30" %>
                    </button>
                    <div class="offcanvas offcanvas-bottom" tabindex="-1" id="offcanvasBottom<%= "#{post.id}" %>" aria-labelledby="offcanvasBottomLabel">
                      <div class="offcanvas-header d-flex justify-content-end pt-3 pe-3 pb-0">
                        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
                      </div>
                      <div class="offcanvas-body small">
                        <div class="d-grid gap-2 col-6 mx-auto">
                          <%= link_to '詳細', post_path(post), class: "btn btn-outline-dark fs-small fs-sm-medium pt-2 px-sm-3", type: "button"  %>
                          <%# ログインしているか・投稿者本人かを確認 %>
                          <% if logged_in? && current_user.id == post.user.id %>
                            <%= link_to '編集', edit_post_path(post), class: "btn btn-outline-dark fs-small fs-sm-medium pt-2 px-sm-3", type: "button"  %>
                            <%= link_to '削除', post_path(post), method: "delete", data: { confirm: "削除しますか？"}, class: "btn btn-outline-dark fs-small fs-sm-medium pt-2 px-sm-3", type: "button"   %>
                          <% end %>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

<%= javascript_pack_tag 'audio-playback' %>
<%= javascript_pack_tag 'post-text-ellipsis.js' %>