<div class="bkg-img">
  <h1 class="text-white text-left ps-2 ps-md-5 py-3 mb-4">投稿編集</h1>
  <div class="container">
    <%= render partial: 'layouts/flash' %>

    <div class="mx-2 mx-md-5 px-lg-5">
      <%= form_with model: @post, local: true do |f| %>
        <div class="row card bg-dark-card py-4 px-lg-5 mx-lg-5">
          <div  class="mb-4 px-3 px-sm-5">
            <%= f.label :title, "タイトル", class: "form-label text-white fs-xlarge mb-1" %>
            <%= f.text_field :title, class: "form-control form-control-lg w-100", placeholder: "タイトル" %>
          </div>
          <div  class="mb-4 px-3 px-sm-5">
            <%= f.label :body, "内容", class: "form-label text-white fs-xlarge mb-1" %>
            <%= f.text_area :body, class: "form-control form-control-lg", rows: "3" %>
          </div>
          <div  class="d-flex flex-column mb-4 px-3 px-sm-5">
            <%= f.label :status, "表示設定", class: "form-label text-white fs-xlarge mb-1" %>
            <div class="pt-1 ps-4">
              <%= f.radio_button :status, :published %>
              <%= f.label :status_published, "公開", class: "form-label text-white fs-larger" %>
            </div>
            <div class="ps-4">
              <%= f.radio_button :status, :unpublished %>
              <%= f.label :status_unpublished, "非公開", class: "form-label text-white fs-larger" %>
            </div>
          </div>
          <div class="audio px-3 px-sm-5 pb-1">
            <p class="text-white fs-xlarge mb-1">録音音声</p>
            <%= render "layouts/guest_tutorial/audio_slider", slider_type: "audio", slider_size: "100", audio_blob_url: @post.voice %>
            <%#= audio_tag(url_for(@post.voice), id: "record", controls: true) %>
            <%# <button type="button" class="btn btn-outline-secondary mb-3" id="playback">再生する</button> %>
          </div>
        </div>
        <div class="row justify-content-center py-4">
          <%= f.submit "更新する",  class: "btn btn-success fw-bold fs-large col-4 col-sm-3 py-3 me-3 me-sm-5" %>
          <%= link_to "戻る", posts_path, class: "btn btn-outline-success fw-bold fs-large col-4 col-sm-3 py-3 me-3 ms-sm-5" %>
        </div>
      <% end %>
    </div>

  </div>
</div>

<%= javascript_pack_tag 'audio-playback' %>