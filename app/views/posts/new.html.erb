
<%# 録音画面 %>
<div class="bkg-img-index" id="recording_screen">
  <h1 class="text-white ps-2 ps-md-5 py-4 pb-lg-5">RECORDING</h1>
  <div class="container">
    <%# 一覧または詳細画面からコラボボタンがクリックされた場合、音源再生用のスライダーを表示する %>
    <% if @audio_flg.present? && @audio_flg == "default_audio" %>
      <div class="d-flex flex-column align-items-center mb-5">
        <h3 class="text-white text-start mb-4">↓↓ 元音源を確認 ↓↓</h3>
        <div class="col-10 col-sm-8 col-lg-6">
          <%= render "layouts/guest_tutorial/audio_slider", slider_type: "audio", slider_size: "100", audio_data_url: "/test.mp3" %>
          <%#= render "shared/audio_player", audio_container_class: "js-default-audio-container", slider_size: "50" %>
        </div>
      </div>
    <% elsif @audio_flg.present? && @audio_flg == "posted_audio" %>
      <div class="d-flex flex-column align-items-center mb-5">
        <h3 class="text-white text-start mb-4">↓↓ 元音源を確認 ↓↓</h3>
        <div class="col-10 col-sm-8 col-lg-6">
          <%= render "layouts/guest_tutorial/audio_slider", slider_type: "audio", slider_size: "100", audio_blob_url: @collab_post.voice  %>
          <%#= render "shared/audio_player", audio_container_class: "js-posted-audio-container", audio_blob: @collab_post.voice, slider_size: "50" %>
        </div>
      </div>
    <% end %>


    <div class="pb-3">
      <h3 class="text-center text-white mb-4">↓↓録音開始↓↓</h3>
      <div class="row justify-content-center mb-3">
        <div class="col d-flex justify-content-center mb-4">
          <%= render "layouts/guest_tutorial/recording_btn" %>
        </div>
        <div class="w-100"></div>
        <div class="col-10 col-sm-8 col-lg-6 pt-5" id="rspec-system-spec">
          <%= render "layouts/guest_tutorial/audio_slider", slider_type: "post-record", slider_size: "100" %>
          <%# 録音完了後にボタン表示 %>
          <div class="d-flex justify-content-center pt-5">
            <% if logged_in? %>
              <button type="button" class="btn btn-success btn-lg btn-tutorial-custom text-white rounded-pill fw-bold fs-xlarge py-3 px-5 none" id="buttonNext" >次へ</button>
            <% end %>
          </div>
        </div>
      </div>
    </div>

  </div>
</div>

<%# 投稿フォーム %>
<% if logged_in? %>
  <div class="bkg-img form-style" id="post_form">
    <h1 class="text-white text-left ps-2 ps-md-5 py-3 mb-4">投稿フォーム</h1>
    <div class="container">
      <div class="row justify-content-center">
        <div class="col-10 col-md-8 col-lg-9 col-xl-8 col-xxl-7 pb-5">
          <%= render partial: 'layouts/flash' %>
          <%= form_with model: @post, local: true do |f| %>
            <div class="row card bg-dark-card py-3 px-2 px-sm-3 p-md-4 p-lg-5 mx-lg-5">
              <div  class="mb-4">
                <%= f.label :title, "タイトル", class: "form-label text-white fs-larger fs-sm-xlarge mb-1" %>
                <%= f.text_field :title, class: "form-control form-control-lg w-100", placeholder: "タイトル" %>
              </div>
              <div  class="mb-4">
                <%= f.label :body, "内容", class: "form-label text-white fs-larger fs-sm-xlarge mb-1" %>
                <%= f.text_area :body, class: "form-control form-control-lg", rows: "3" %>
              </div>
              <div class="d-flex flex-column mb-4">
                <%= f.label :status, "表示設定", class: "form-label text-white fs-larger fs-sm-xlarge mb-1" %>
                <div class="pt-1 ps-4">
                  <%= f.radio_button :status, :published %>
                  <%= f.label :status_published, "公開", class: "form-label text-white fs-larger" %>
                </div>
                <div class="ps-4">
                  <%= f.radio_button :status, :unpublished %>
                  <%= f.label :status_unpublished, "非公開", class: "form-label text-white fs-larger" %>
                </div>
              </div>

              <%# 隠しフィールドを追加して、Blob IDを保存できるようにする %>
              <%= f.hidden_field :voice_blob_id, id: 'post_voice_blob_id' %>

              <%# 録音音声を表示 %>
              <div class="audio">
                <p class="text-white fs-larger fs-sm-xlarge mb-1">録音音声</p>
                <%= render "layouts/guest_tutorial/audio_slider", slider_type: "form-record", slider_size: "100" %>
              </div>
              <div class="d-flex justify-content-center pt-5">
                <%= f.submit "投稿する",  class: "btn btn-success btn-tutorial-custom rounded-pill col-5 col-sm-4 fw-bold fs-large py-3" %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
<% end %>

<%# JS読み込み %>
<% if @audio_flg.present? %>
  <%= javascript_pack_tag 'audio-playback' %>
<% end %>

<%= javascript_pack_tag 'create-audio' %>