<div class="bkg-img-pro">
  <h1 class="text-white ps-2 ps-md-5 py-3 pb-lg-4">プロフィール編集</h1>
  <div class="container">
    <div class="row justify-content-center">
      <%= render partial: 'layouts/flash' %>
      <div class="col-11 col-sm-10 col-md-8 col-lg-9 col-xl-8 col-xxl-7 pb-5">
        <%= form_with model: @user, url: profile_path, local: true do |f| %>
          <div class="row card bg-color-pro pt-4 pb-3 px-lg-5 mx-lg-5">
            <div class="mb-4 px-3 px-sm-5">
              <%= f.label :name, "名前", class: "text-white fs-larger fs-sm-xlarge mb-1" %>
              <%= f.text_field :name, class: "form-control form-control-lg" %>
            </div>

            <div class="mb-4 px-3 px-sm-5">
              <%= f.label :email, "メールアドレス", class: "text-white fs-larger fs-sm-xlarge mb-1" %>
              <%= f.email_field :email, class: "form-control form-control-lg" %>
            </div>

            <div class="mb-4 px-3 px-sm-5">
              <%= f.label :avatar, "プロフィール画像", class: "text-white fs-larger fs-sm-xlarge mb-1" %>
              <%= f.file_field :avatar, class: "form-control form-control-lg", id: 'avatarImg', accept: 'image/*' %>
              <%= f.hidden_field :avatar_cache %>
              <div class='mt-3 py-2 text-center'>
                <%# FIXME: 画像ファイルが正しく読みこまえれない場合、一時的にデフォルトアバターを表示させる 23/12/24 %>
                <%#= image_tag @user.avatar.url, id: 'preview', class: 'rounded-circle', size: '100x100' %>
                <%= avatar_image_tag(@user, 'rounded-circle border border-secondary', '100x100') %>
              </div>
            </div>

            <div class="d-flex justify-content-center py-3">
              <%= f.submit "更新", class: "btn btn-success btn-tutorial-custom rounded-pill fw-bold fs-large col-4 col-sm-3 py-3 me-3 me-sm-3" %>
              <%= link_to "戻る", profile_path, class: "btn btn-outline-success btn-tutorial-custom rounded-pill btn-profile-custom fw-bold fs-large col-4 col-sm-3 py-3 ms-sm-3" %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>

<%= javascript_pack_tag 'preview.js' %>