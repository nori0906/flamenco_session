<div class="bg-dark-custom py-5">
  <div class="text-white text-center">
    <h1 class="fw-bold">アプリの使い方</h1>
  </div>
  <%# チュートリアル %>
  <section class="app-use-section">
    <div class="container py-5 px-3 px-sm-5" id="explain-tutorial">
      <div class="row justify-content-center">
        <div class="col-11 col-md-8 col-lg-7 col-xl-6 col-xxl-5">
          <h2 class="text-center text-white fw-bold fs-xlarge fs-lg-xxlarge pb-2">チュートリアル</h2>
          <div class="w-100"></div>
          <%# カード %>
          <div id="carouselTutorialIndicators" class="carousel slide">
            <div class="carousel-indicators">
              <button type="button" data-bs-target="#carouselTutorialIndicators" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
              <button type="button" data-bs-target="#carouselTutorialIndicators" data-bs-slide-to="1" aria-label="Slide 2"></button>
              <button type="button" data-bs-target="#carouselTutorialIndicators" data-bs-slide-to="2" aria-label="Slide 3"></button>
            </div>
            <div class="carousel-inner">
              <div class="carousel-item active">
                <div class="d-flex flex-column card text-light border border-5 border-light rounded-5 bg-dark-card pb-5 px-2 px-sm-3">
                  <div class="card-body ps-0 pe-3 px-sm-3 px-md-4 px-lg-5">
                    <h3 class="card-title text-center fw-bold fs-larger fs-sm-xlarge my-2 my-sm-3">STEP1</h3>
                    <div class="card-text">
                      <h4 class="fw-bold border-bottom border-2 fst-italic fs-larger fs-sm-xlarge mb-2 mb-sm-4">チュートリアルへ移動</h4>
                      <ol class="fw-medium mb-0">
                        <li><p class="fs-medium fs-lg-larger mb-2">「はじめる」を押す</p></li>
                        <li><p class="fs-medium fs-lg-larger mb-1">「チュートリアル」を選択</p></li>
                        <ul class="list-unstyled">
                          <li><p class="fs-small fs-sm-smaller fs-lg-medium ms-2 mb-0">※ 右上メニューの「チュートリアル」でも可能</p></li>
                        </ul>
                      </ol>
                    </div>
                  </div>
                  <%# 画像は仮で設定 %>
                  <div class="text-center">
                    <%= image_pack_tag "media/images/how_to_use_app/pc_tutorial_1.gif", class: "rounded-3 app-use-image" %>
                  </div>
                </div>
              </div>
              <div class="carousel-item">
                <div class="d-flex flex-column card text-light border border-5 border-light rounded-5 bg-dark-card pb-5 px-2 px-sm-3">
                  <div class="card-body ps-0 pe-3 px-sm-3 px-md-4 px-lg-5">
                    <h3 class="card-title text-center fw-bold fs-larger fs-sm-xlarge my-2 my-sm-3">STEP2</h3>
                    <div class="card-text">
                      <h4 class="fw-bold border-bottom border-2 fst-italic fs-larger fs-sm-xlarge mb-2 mb-sm-4">パルマ（手拍子）を学ぶ</h4>
                      <ol class="fw-medium mb-0">
                        <li><p class="fs-medium fs-lg-larger mb-2">解説を確認</p></li>
                        <li><p class="fs-medium fs-lg-larger mb-1">難易度を選択し、録音画面へ移動</p></li>
                        <%# <ul class="list-unstyled">
                          <li><p class="fs-small fs-sm-smaller fs-lg-medium ms-2 mb-0">※ 難易度1または2で感覚をつかもう！</p></li>
                        </ul> %>
                      </ol>
                    </div>
                  </div>
                  <%# 画像は仮で設定 %>
                  <div class="text-center">
                    <%= image_pack_tag "media/images/how_to_use_app/pc_tutorial_2.gif", class: "rounded-3 app-use-image" %>
                  </div>
                </div>
              </div>
              <div class="carousel-item">
                <div class="d-flex flex-column card text-light border border-5 border-light rounded-5 bg-dark-card pb-5 px-2 px-sm-3">
                  <div class="card-body ps-0 pe-3 px-sm-3 px-md-4 px-lg-5">
                    <h3 class="card-title text-center fw-bold fs-larger fs-sm-xlarge my-2 my-sm-3">STEP3</h3>
                    <div class="card-text">
                      <h4 class="fw-bold border-bottom border-2 fst-italic fs-larger fs-sm-xlarge mb-2 mb-sm-4">パルマを叩いて録音!!</h4>
                      <ol class="fw-medium mb-0">
                        <li><p class="fs-medium fs-lg-larger mb-2">録音方法・お手本音声を確認する</p></li>
                        <li><p class="fs-medium fs-lg-larger mb-1">「REC/STOP」で音声を録音</p></li>
                        <ul class="list-unstyled">
                          <li><p class="fs-small fs-sm-smaller fs-lg-medium ms-2 mb-2">※ マイク許可の設定が必要な場合があります</p></li>
                        </ul>
                        <li><p class="fs-medium fs-lg-larger mb-0">「PLAY/PAUSE」で音声を確認</p></li>
                      </ol>
                    </div>
                  </div>
                  <%# 画像は仮で設定 %>
                  <div class="text-center">
                    <%= image_pack_tag "media/images/how_to_use_app/pc_tutorial_3.gif", class: "rounded-3 app-use-image" %>
                  </div>
                </div>
              </div>
            </div>
            <button class="carousel-control-prev" type="button" data-bs-target="#carouselTutorialIndicators" data-bs-slide="prev">
              <span class="carousel-control-prev-icon" aria-hidden="true"></span>
              <span class="visually-hidden">Previous</span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#carouselTutorialIndicators" data-bs-slide="next">
              <span class="carousel-control-next-icon" aria-hidden="true"></span>
              <span class="visually-hidden">Next</span>
            </button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <%# 録音 %>
  <section class="app-use-section bg-dark-sub-custom">
    <div class="container py-5 px-3 px-sm-5" id="explain-recording">
      <div class="row justify-content-center">
        <div class="col-11 col-md-8 col-lg-7 col-xl-6 col-xxl-5">
          <h2 class="text-center text-white fw-bold fs-xlarge fs-lg-xxlarge pb-2">録音する</h2>
          <div class="w-100"></div>
          <div id="carouselRecordingIndicators" class="carousel slide">
            <div class="carousel-indicators">
              <button type="button" data-bs-target="#carouselRecordingIndicators" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
              <button type="button" data-bs-target="#carouselRecordingIndicators" data-bs-slide-to="1" aria-label="Slide 2"></button>
              <button type="button" data-bs-target="#carouselRecordingIndicators" data-bs-slide-to="2" aria-label="Slide 3"></button>
            </div>
            <div class="carousel-inner">
              <div class="carousel-item active">
                <div class="d-flex flex-column card text-light border border-5 border-light rounded-5 bg-dark-card pb-5 px-2 px-sm-3">
                  <div class="card-body ps-0 pe-3 px-sm-3 px-md-4 px-lg-5">
                    <h3 class="card-title text-center fw-bold fs-larger fs-sm-xlarge my-2 my-sm-3">STEP1</h3>
                    <div class="card-text">
                      <h4 class="fw-bold border-bottom border-2 fst-italic fs-larger fs-sm-xlarge mb-2 mb-sm-4">録音画面へ移動</h4>
                      <ol class="fw-medium mb-0">
                        <li><p class="fs-medium fs-lg-larger mb-1">「はじめる」→「投稿一覧」を選択</p></li>
                        <ul class="list-unstyled">
                          <li><p class="fs-small fs-sm-smaller fs-lg-medium ms-2 mb-2">※ 右上メニューの「投稿一覧」でも可能</p></li>
                        </ul>
                        <li><p class="fs-medium fs-lg-larger mb-1">「新規録音/投稿」を押す</p></li>
                        <ul class="list-unstyled">
                          <li><p class="fs-small fs-sm-smaller fs-lg-medium ms-2 mb-1">※ 新規投稿するにはログインが必要</p></li>
                          <li><p class="fs-small fs-sm-smaller fs-lg-medium ms-2 mb-2">※ 未ログインでも録音までは可能</p></li>
                        </ul>
                      </ol>
                    </div>
                  </div>
                  <%# 画像は仮で設定 %>
                  <div class="text-center">
                    <%= image_pack_tag "media/images/how_to_use_app/pc_recording_1.gif", class: "rounded-3 app-use-image" %>
                  </div>
                </div>
              </div>
              <div class="carousel-item">
                <div class="d-flex flex-column card text-light border border-5 border-light rounded-5 bg-dark-card pb-5 px-2 px-sm-3">
                  <div class="card-body ps-0 pe-3 px-sm-3 px-md-4 px-lg-5">
                    <h3 class="card-title text-center fw-bold fs-larger fs-sm-xlarge my-2 my-sm-3">STEP2</h3>
                    <div class="card-text">
                      <h4 class="fw-bold border-bottom border-2 fst-italic fs-larger fs-sm-xlarge mb-2 mb-sm-4">録音開始</h4>
                      <ol class="fw-medium mb-0">
                        <li><p class="fs-medium fs-lg-larger mb-2">「REC/STOP」で音声を録音</p></li>
                        <ul class="list-unstyled">
                          <li><p class="fs-small fs-sm-smaller fs-lg-medium ms-2 mb-2">※ スピーカー上で流れる音声が録音される</p></li>
                        </ul>
                        <li><p class="fs-medium fs-lg-larger mb-2">「PLAY/PAUSE」で音声を確認</p></li>
                        <li><p class="fs-medium fs-lg-larger mb-0">「次へ」で投稿フォームへ移動</p></li>
                      </ol>
                    </div>
                  </div>
                  <%# 画像は仮で設定 %>
                  <div class="text-center">
                    <%= image_pack_tag "media/images/how_to_use_app/pc_recording_2.gif", class: "rounded-3 app-use-image" %>
                  </div>
                </div>
              </div>
              <div class="carousel-item">
                <div class="d-flex flex-column card text-light border border-5 border-light rounded-5 bg-dark-card pb-5 px-2 px-sm-3">
                  <div class="card-body ps-0 pe-3 px-sm-3 px-md-4 px-lg-5">
                    <h3 class="card-title text-center fw-bold fs-larger fs-sm-xlarge my-2 my-sm-3">STEP3</h3>
                    <div class="card-text">
                      <h4 class="fw-bold border-bottom border-2 fst-italic fs-larger fs-sm-xlarge mb-2 mb-sm-4">投稿する</h4>
                      <ol class="fw-medium mb-0">
                        <li><p class="fs-medium fs-lg-larger mb-2">タイトル・詳細・公開設定を記入</p></li>
                        <li><p class="fs-medium fs-lg-larger mb-0">「投稿」を押して投稿完了</p></li>
                      </ol>
                    </div>
                  </div>
                  <%# 画像は仮で設定 %>
                  <div class="text-center">
                    <%= image_pack_tag "media/images/how_to_use_app/pc_post.gif", class: "rounded-3 app-use-image" %>
                  </div>
                </div>
              </div>
            </div>
            <button class="carousel-control-prev" type="button" data-bs-target="#carouselRecordingIndicators" data-bs-slide="prev">
              <span class="carousel-control-prev-icon" aria-hidden="true"></span>
              <span class="visually-hidden">Previous</span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#carouselRecordingIndicators" data-bs-slide="next">
              <span class="carousel-control-next-icon" aria-hidden="true"></span>
              <span class="visually-hidden">Next</span>
            </button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <%# セッション %>
  <section  class="app-use-section">
    <div class="container py-5 px-3 px-sm-5" id="explain-collab">
      <div class="row justify-content-center">
        <div class="col-11 col-md-8 col-lg-7 col-xl-6 col-xxl-5">
          <h2 class="text-center text-white fw-bold fs-xlarge fs-lg-xxlarge pb-2">セッションする</h2>
          <div class="w-100"></div>
          <div id="carouselCollabRecIndicators" class="carousel slide">
            <div class="carousel-indicators">
              <button type="button" data-bs-target="#carouselCollabRecIndicators" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
              <button type="button" data-bs-target="#carouselCollabRecIndicators" data-bs-slide-to="1" aria-label="Slide 2"></button>
              <button type="button" data-bs-target="#carouselCollabRecIndicators" data-bs-slide-to="2" aria-label="Slide 3"></button>
            </div>
            <div class="carousel-inner">
              <div class="carousel-item active">
                <div class="d-flex flex-column card text-light border border-5 border-light rounded-5 bg-dark-card pb-5 px-2 px-sm-3">
                  <div class="card-body ps-0 pe-3 px-sm-3 px-md-4 px-lg-5">
                    <h3 class="card-title text-center fw-bold fs-larger fs-sm-xlarge my-2 my-sm-3">STEP1</h3>
                    <div class="card-text">
                      <h4 class="fw-bold border-bottom border-2 fst-italic fs-larger fs-sm-xlarge mb-2 mb-sm-4">録音画面へ移動</h4>
                      <ol class="fw-medium mb-0">
                        <li><p class="fs-medium fs-lg-larger mb-2">投稿一覧画面に移動</p></li>
                        <li><p class="fs-medium fs-lg-larger mb-2">気になる投稿を見つける</p></li>
                        <li><p class="fs-medium fs-lg-larger mb-1">「セッション」を押す</p></li>
                        <ul class="list-unstyled">
                          <li><p class="fs-small fs-sm-smaller fs-lg-medium ms-2 mb-0">※ 最上部の「セッション」ボタンはサンプル音源になる</p></li>
                        </ul>
                      </ol>
                    </div>
                  </div>
                  <%# 画像は仮で設定 %>
                  <div class="text-center">
                    <%= image_pack_tag "media/images/how_to_use_app/pc_collab_1.gif", class: "rounded-3 app-use-image" %>
                  </div>
                </div>
              </div>
              <div class="carousel-item">
                <div class="d-flex flex-column card text-light border border-5 border-light rounded-5 bg-dark-card pb-5 px-2 px-sm-3">
                  <div class="card-body ps-0 pe-3 px-sm-3 px-md-4 px-lg-5">
                    <h3 class="card-title text-center fw-bold fs-larger fs-sm-xlarge my-2 my-sm-3">STEP2</h3>
                    <div class="card-text">
                      <h4 class="fw-bold border-bottom border-2 fst-italic fs-larger fs-sm-xlarge mb-2 mb-sm-4">セッション録音開始</h4>
                      <ol class="fw-medium mb-0">
                        <li><p class="fs-medium fs-lg-larger mb-1">「REC/STOP」で音声を録音</p></li>
                        <ul class="list-unstyled">
                          <li><p class="fs-small fs-sm-smaller fs-lg-medium ms-2 mb-2">※ スピーカー上で流れる音声が録音される</p></li>
                        </ul>
                        <li><p class="fs-medium fs-lg-larger mb-2">「PLAY/PAUSE」でコラボ音声確認</p></li>
                        <li><p class="fs-medium fs-lg-larger mb-0">「次へ」で投稿フォームへ移動</p></li>
                      </ol>
                    </div>
                  </div>
                  <%# 画像は仮で設定 %>
                  <div class="text-center">
                    <%= image_pack_tag "media/images/how_to_use_app/pc_collab_2.gif", class: "rounded-3 app-use-image" %>
                  </div>
                </div>
              </div>
              <div class="carousel-item">
                <div class="d-flex flex-column card text-light border border-5 border-light rounded-5 bg-dark-card pb-5 px-2 px-sm-3">
                  <div class="card-body ps-0 pe-3 px-sm-3 px-md-4 px-lg-5">
                    <h3 class="card-title text-center fw-bold fs-larger fs-sm-xlarge my-2 my-sm-3">STEP3</h3>
                    <div class="card-text">
                      <h4 class="fw-bold border-bottom border-2 fst-italic fs-larger fs-sm-xlarge mb-2 mb-sm-4">投稿する</h4>
                      <ol class="fw-medium mb-0">
                        <li><p class="fs-medium fs-lg-larger mb-2">タイトル・詳細・公開設定を記入</p></li>
                        <li><p class="fs-medium fs-lg-larger mb-0">「投稿」を押して投稿完了</p></li>
                      </ol>
                    </div>
                  </div>
                  <%# 画像は仮で設定 %>
                  <div class="text-center">
                    <%= image_pack_tag "media/images/how_to_use_app/pc_post.gif", class: "rounded-3 app-use-image" %>
                  </div>
                </div>
              </div>
            </div>
            <button class="carousel-control-prev" type="button" data-bs-target="#carouselCollabRecIndicators" data-bs-slide="prev">
              <span class="carousel-control-prev-icon" aria-hidden="true"></span>
              <span class="visually-hidden">Previous</span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#carouselCollabRecIndicators" data-bs-slide="next">
              <span class="carousel-control-next-icon" aria-hidden="true"></span>
              <span class="visually-hidden">Next</span>
            </button>
          </div>
        </div>
      </div>
    </div>
  </section>
</div>

