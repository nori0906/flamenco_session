<header class="sticky-top">
  <nav class="navbar navbar-expand-lg navbar-light shadow-sm bg-color">
    <div class="container-fluid">
      <div>
        <%= image_pack_tag "media/images/music_icon.png", class: "mb-2", size: 5*5 %>
        <a class="navbar-brand text-white font-monospace fw-bold fs-large fs-sm-larger me-0" href="/">フラッと×セッション</a>
      </div>
      <%# スマホサイズのメニュー表示 (>lg) %>
      <div class="card-offcanvas">
        <button class="d-flex navbar-toggler d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#offcanvasRight" aria-controls="offcanvasRight">
          <p class="align-self-center font-monospace fw-bold mb-0 pe-2">MENU</p>
          <span class="navbar-toggler-icon"></span>
        </button>

        <div class="offcanvas-lg offcanvas-end bg-dark-custom" tabindex="-1" id="offcanvasRight" aria-labelledby="offcanvasRightLabel">
          <div class="offcanvas-header">
            <h5 class="offcanvas-title text-white" id="offcanvasRightLabel">MENU</h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" data-bs-target="#offcanvasRight" aria-label="Close"></button>
          </div>
          <div class="offcanvas-body text-white d-lg-none">
            <div class="border-bottom border-3 mb-2">
              <% if logged_in? %>
                <%# FIXME: アバターパスのエラーの対応で一時的に変更（app/helpers/application_helper.rbでメソッド使用） %>
                <%= avatar_image_tag(current_user, 'rounded-circle border border-secondary', '60x60') %>
                <div class="fs-xlarge fw-bold pt-2 pb-2"><%= current_user.name %></div>
              <% end %>
            </div>
            <div class="d-flex flex-column nav font-monospace fs-larger ps-2">
              <%= link_to "投稿一覧", posts_path, class: "nav-link text-white" %>
              <%# アクセス制限 %>
              <% if logged_in? %>
                <%= link_to "録音する", new_post_path, class: "nav-link text-white" %>
                <%= link_to 'Myプロフィール', profile_path, class: 'nav-link text-white' %>
                <%= link_to 'ログアウト', logout_path, class: 'nav-link text-white', method: :delete %>
              <% else %>
                <%= link_to "アカウント登録", new_user_path, class:"nav-link text-white" %>
                <%= link_to 'ログイン', login_path, class: 'nav-link text-white' %>
              <% end %>
            </div>
          </div>
        </div>
      </div>
      <%# PCサイズのメニュー表示 (lg<=) %>
      <div class="collapse navbar-collapse" id="navbarSupportedContent">
        <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
          <li><%= link_to "投稿一覧", posts_path, class: "nav-link font-monospace text-white" %></li>
          <%# アクセス制限 %>
          <% if logged_in? %>
            <li><%= link_to "録音する", new_post_path, class: "nav-link font-monospace text-white" %></li>
            <li>
              <div class="dropdown">
                <a href="#" class="nav-link dropdown-toggle" id="dropdownMenuButton1" data-bs-toggle="dropdown" aria-expanded="false">
                  <%# FIXME: アバターパスのエラーの対応で一時的に変更（app/helpers/application_helper.rbでメソッド使用） %>
                  <%#= image_tag current_user.avatar_url, class: 'rounded-circle', size: '30x30'%>
                  <%= avatar_image_tag(current_user, 'rounded-circle border border-secondary', '30x30') %>
                </a>
                <div class='dropdown-menu dropdown-menu-end bg-dark-custom text-white px-1' data-bs-theme="dark">
                  <div class='dropdown-item text-white fw-bold border-bottom border-2 fs-larger ps-2 mb-2'><%= current_user.name %></div>
                  <%= link_to 'Myプロフィール', profile_path, class: 'dropdown-item font-monospace text-white fs-large' %>
                  <%= link_to 'ログアウト', logout_path, class: 'dropdown-item font-monospace text-white fs-large', method: :delete %>
                </div>
              </div>
            </li>
            
          <% else %>
            <li><%= link_to "アカウント登録", new_user_path, class:"nav-link font-monospace text-white" %></li>
            <li><%= link_to 'ログイン', login_path, class: 'nav-link font-monospace text-white' %></li>
          <% end %>
        </ul>
      </div>
    </div>
  </nav>
</header>