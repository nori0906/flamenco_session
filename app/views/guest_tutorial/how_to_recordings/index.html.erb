<div class="container bkg-img-index text-white">
  <h1 class="ps-2 ps-md-5 py-4 pb-lg-5">RECORDING</h1>
  <div class="row justify-content-center">
    <div class="col-11 col-sm-10 col-lg-9 col-xl-8 col-xxl-7 px-3">
      <div class="text-center fs-xlarge fs-md-xxlarge mb-4" id="level-select">
        <%# how_to_recordings_helper.rbでメソッド作成 %>
        <h2 class="fw-semibold"><%= by_level_title(@level)[:type] %></h2>
        <h2 class="fw-semibold"><%= by_level_title(@level)[:title] %></h2>
      </div>
      <div class="d-flex justify-content-center mb-4 mx-lg-5">
        <%= render "layouts/guest_tutorial/#{@level}_help_text" %>
      </div>

      <%# 録音 %>
      <div class="pt-4 pb-3 mt-5 mb-5">
        <h3 class="text-center mb-4">↓↓録音開始↓↓</h3>
        <div class="row justify-content-center mb-3">
          <div class="col d-flex justify-content-center mb-4">
            <%= render "layouts/guest_tutorial/recording_btn" %>
          </div>
          <div class="w-100 mt-4"></div>
          <div class="col-11 col-md-9 col-lg-9 col-xxl-8 pt-4">
            <%= render "layouts/guest_tutorial/audio_slider", slider_type: "tutorial-record", slider_size: "100" %>
          </div>
        </div>
      </div>

      <% if @level == 'hard' %>
        <div class="row justify-content-center pb-5">
          <%= link_to "投稿を見る", guest_index_path, class: "btn btn-success  btn-tutorial-custom col-5 col-sm-4 col-md-3 col-xl-3 text-white rounded-pill fw-bold fs-large fs-sm-larger fs-lg-xlarge py-2 py-xxl-3 me-sm-4" , type: "button" %>
          <div class="w-100 d-sm-none mt-3"></div>
          <%= link_to "戻る", guest_tutorial_introductions_path, class: "btn btn-success btn-tutorial-custom col-5 col-sm-4 col-md-3 col-xl-3 text-white rounded-pill fw-bold fs-large fs-sm-larger fs-lg-xlarge py-2 py-xxl-3" , type: "button" %>
        </div>
      <% else %>
        <div class="d-flex justify-content-center pb-5">
          <%= link_to "次のステップへ", guest_tutorial_introductions_path, class: "btn btn-success btn-lg btn-tutorial-custom text-white rounded-pill fw-bold fs-large fs-sm-xlarge py-3 px-4" , type: "button" %>
        </div>
      <% end %>

    </div>
  </div>
</div>

<%# js読み込み %>
<%= javascript_pack_tag 'audio-playback' %>
<%= javascript_pack_tag 'create-audio' %>
