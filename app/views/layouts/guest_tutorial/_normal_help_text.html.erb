<div class="card border border-2 border-white bg-color card-shadow-dark">
  <div class="card-body text-white p-sm-4">
    <div class="card-text">
      <div class="mb-4 mb-md-5">
        <h3 class="d-inline-block border-bottom border-3 fw-semibold fs-large fs-sm-larger fs-md-xlarge">タパとは？</h3>
        <div class="fs-medium fs-md-large ms-2">
          <ul>
            <li>ギター奏法の一つ。</li>
            <li>音をミュートしてジャカジャカと鳴らす弾き方で、リズム出しなどに使われる。</li>
          </ul>
          <p class="mb-2"></p>
          <p class="mb-2"></p>
          </p>
        </div>
      </div>

      <div class="row">
        <div class="col col-lg-10 col-xl-9 col-xxl-8" id="role-model-container">
          <h3 class="d-inline-block border-bottom border-3 fw-semibold fs-large fs-sm-larger fs-md-xlarge">お手本</h3>
          <%= render "layouts/guest_tutorial/audio_slider", slider_type: "audio", slider_size: "100", audio_data_url: "/test.mp3" %>
          <%#= render "layouts/guest_tutorial/audio_slider", slider_type: "model-audio", slider_size: "100" %>
        </div>
        <div class="w-100 mt-4"></div>
        <div class="col col-lg-10 col-xl-9 col-xxl-8" id="collab-source-container">
          <h3 class="d-inline-block border-bottom border-3 fw-semibold fs-large fs-sm-larger fs-md-xlarge">コラボ音源</h3>
          <%= render "layouts/guest_tutorial/audio_slider", slider_type: "audio", slider_size: "100", audio_data_url: "/test.mp3" %>
          <%#= render "layouts/guest_tutorial/audio_slider", slider_type: "audio", slider_size: "100" %>
        </div>
      </div>
    </div>
  </div>
</div>