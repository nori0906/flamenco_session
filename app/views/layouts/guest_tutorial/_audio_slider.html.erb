<%# WebAudioAPIでコントローラー作成 %>
<div class="js-audio-player-container bg-custom-audio-slider border border-secondary border-3 rounded-pill d-flex align-items-center w-<%= "#{slider_size}" %> py-2 px-4">
  <%# audio_blob_urlが渡された場合（投稿データのに保存されている音源を再生する場合） %>
  <% if defined?(audio_blob_url) && !defined?(audio_data_url) %>
    <button type="button"
            class= "<%= "#{slider_type}" %>-playback btn btn-outline-danger flex-fill border border-danger border-3 fst-italic me-3 me-sm-2"
            data-audio-url= "<%= rails_blob_path(audio_blob_url, disposition: "attachment") %>" >
      Play
    </button>
  <%# audio_data_urlが渡された場合（デフォルトでアプリに保存されている音源を再生する場合） %>
  <% elsif defined?(audio_data_url) && !defined?(audio_blob_url) %>
    <button type="button"
            class="<%= "#{slider_type}" %>-playback btn btn-outline-danger flex-fill border border-danger border-3 fst-italic me-3 me-sm-2"
            data-audio-url= <%= audio_data_url %> >
      Play
    </button>
  <%# 新規録音を再生する場合 %>
  <% else %>
    <button type="button"
            class="<%= "#{slider_type}" %>-playback btn btn-outline-danger flex-fill border border-danger border-3 fst-italic me-3 me-sm-2">
      Play
    </button>
  <% end %>
  
  <button type="button" class="<%= "#{slider_type}" %>-stop btn btn-outline-primary flex-fill border border-primary border-3 fst-italic me-3" disabled>Pause</button>
  <span class="<%= "#{slider_type}" %>-playback-time flex-fill text-white">0:00</span>
  <input class="<%= "#{slider_type}" %>-slider d-none d-md-none d-sm-block d-lg-block flex-fill ms-2" type="range" min="0" max="100" value="0" style="width: 80%;">
</div>
