                <div class="col">
                  <div class="row row-cols-2">
                    <div class="col d-flex flex-column align-items-center">
                      <div>
                        <p class="fw-semibold fs-medium fs-sm-large mb-1">録音する</p>
                      </div>
                      <div>
                        <a href="#explain-recording">
                          <div class = "icon-container">
                            <%= image_pack_tag "media/images/icon/recording-icon.png", size: "50x50" %>
                            <div class = "icon-underlay">
                              <%= image_pack_tag "media/images/icon/base-icon.png", size: "70x10" %>
                            </div>
                            <i class="fa-solid fa-angles-down fa-beat" style="color: #ffffff;"></i>
