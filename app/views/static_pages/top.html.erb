<!-- Modal -->
<div class="modal fade" id="gusetModal" tabindex="-1" aria-labelledby="gusetModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content">
      <div class="modal-header border-0 rounded bg-dark-custom">
        
        <div class="bodal-body text-white text-center d-flex justify-content-evenly w-100 my-4">
          <div>
            <h5 class="fw-bold mb-4" id="gusetModalLabel">チュートリアルを始める</h5>
            <%= link_to "チュートリアル", guest_tutorial_introductions_path, class: "btn btn-lg btn-custom text-white border border-dark rounded-pill fw-bold" , type: "button" %>
          </div>
          <div>
            <h5 class="fw-bold mb-4" id="gusetModalLabel">みんなの投稿を見る</h5>
            <%= link_to "投稿を見る", guest_index_path, class: "btn btn-lg btn-custom text-white border border-dark rounded-pill fw-bold" , type: "button" %>
          </div>
        </div>

        <div class="align-self-start">
          <button type="button" class="btn-close text-white" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
      </div>
    </div>
  </div>
</div>

<%# ビュー %>
<section>
  <div class="top-wrapper">
    <div class="text-white d-flex justify-content-center w-100 h-100 bkg-overlay">
      <div class="align-self-center text-center">
        <div class="pt-lg-5 pb-sm-5">
          <div class="d-sm-none position-relative mb-4">
            <h1 class="display-3 fw-bold pb-3 mb-0" >フラッと</h1>
            <h1 class="display-2 fw-bold position-absolute top-50 start-50 translate-middle">×</h1>
            <h1 class="display-3 fw-bold pt-3" >セッション</h1>
          </div>
          <div class="d-none d-sm-block mb-4">
            <h1 class="display-3 fw-bold" >フラッと×セッション</h1>
          </div>
          <p class="fs-large fs-sm-xlarge font-monospace">フラメンコ音楽で<br class="d-block d-sm-none">繋がる・体験する・発見する</p>
        </div>
        <div class="d-inline-flex flex-column flex-sm-row py-4 pb-md-5">
          <%= link_to "はじめる", posts_path, class: "btn btn-lg btn-custom text-white border border-dark rounded-pill fw-bold py-3 mb-5 mb-sm-0 me-sm-5" , type: "button", data: { bs_toggle: "modal", bs_target: "#gusetModal" } %>
          <%= link_to "ログイン", login_path, class: "btn btn-lg btn-custom text-white border border-dark rounded-pill fw-bold py-3 ms-sm-3", type: "button" %>
        </div>
        <div class="pt-5">
          <a href="#app_overview" class="top-anchor-link"><i class="fa-solid fa-hand-point-down fa-beat castom-size"></i></a>
        </div>
      </div>
    </div>
  </div>
</section>

<section id="app_overview">
  <div class="bg-dark bg-gradient text-white text-center pb-5">
    <div class="pt-5 pb-4 ">
      <h1 class='fw-bold'>フラっとセッションとは？</h1>
    </div>
    <div class='container font-monospace px-4'>
      <div class="text-start text-sm-center fs-medium fs-sm-large fs-lg-xlarge px-3 px-sm-0">
        <p class="mb-3">
          フラメンコ音楽をベースとした録音・音声コラボ・共有が気軽にできる録音投稿アプリです。
        </p>
        <p>
          未経験・初心者でもフラメンコ特有の「合わせ」をオンライン上て体験できます！
        </p>
      </div>
      
      <%# アイコン追加 %>
      <div class="d-flex justify-content-center mt-5 pt-4">
        <div class = "icon-container pe-3 pe-sm-5">
          <%= image_pack_tag "media/images/icon/search-icon.png", size: "50x50" %>
          <div class = "icon-underlay">
            <%= image_pack_tag "media/images/icon/base-icon.png", size: "70x10" %>
          </div>
          <p class="fs-5">①投稿チェック</p>
        </div>

        <div class = "icon-container pe-3 pe-sm-5">
          <%= image_pack_tag "media/images/icon/recording-icon.png", size: "50x50" %>
          <div class = "icon-underlay">
            <%= image_pack_tag "media/images/icon/base-icon.png", size: "70x10" %>
          </div>
          <p class="fs-5">②録音・コラボ</p>
        </div>

        <div class = "icon-container pe-3 pe-sm-5">
          <%= image_pack_tag "media/images/icon/post-icon.png", size: "50x50" %>
          <div class = "icon-underlay">
            <%= image_pack_tag "media/images/icon/base-icon.png", size: "70x10" %>
          </div>
          <p class="fs-5">③新規投稿</p>
        </div>
      </div>


      <div class="row row-cols-1 row-cols-lg-2 g-5 mt-2">
        <div class="col">
          <div class="pt-5">
            <h2 class="fw-bold fs-3">フラメンコが初めての方</h2>
          </div>
          <div class="card bg-transparent border border-white border-4 fw-bold p-3 mt-4 mx-4">
            <div class="card-text text-start">
              <ul class="list-unstyled text-white fs-medium fs-sm-large mb-0">
                <li class="mb-3"><i class="fa-regular fa-square-check fa-lg"></i> チュートリアルでフラメンコを擬似体験！</li>
                <li class="mb-2"><i class="fa-regular fa-square-check fa-lg"></i> 投稿を見て・聴いてフラメンコ音楽に触れられる！</li>
              </ul>
            </div>
          </div>
        </div>
        <div class="col">
          <div class="pt-5">
            <h2 class="fw-bold fs-3">フラメンコ経験がある方</h2>
          </div>
          <div class="card bg-transparent border border-white border-4 fw-bold p-3 mt-4 mx-4">
            <div class="card-text text-start">
              <ul class="list-unstyled text-white fs-medium fs-sm-large mb-0">
                <li class="mb-3"><i class="fa-regular fa-square-check fa-lg"></i> 日々の練習成果を気軽にアウトプットする場として活用！</li>
                <li class="mb-3"><i class="fa-regular fa-square-check fa-lg"></i> 他ユーザーとの音声セッション（コラボ）ができる！</li>
                <li class="mb-2"><i class="fa-regular fa-square-check fa-lg"></i> 歌・踊り・ギターの垣根を超えた交流ができる！</li>
              </ul>
            </div>
          </div>
        </div>

        <div class="col d-flex flex-column align-items-center">
          <div class="pt-4">
            <h2 class="fw-bold fs-3">どんな音楽？</h2>
          </div>
          <div class="pt-3">
            <p class="fw-bold mb-1">フラメンコを知る</p>
            <a class="hover-test" href="#introduction">
              <div class = "icon-container">
                <%= image_pack_tag "media/images/icon/guitar-icon.png", size: "50x50" %>
                <div class = "icon-underlay">
                  <%= image_pack_tag "media/images/icon/base-icon.png", size: "70x10" %>
                </div>
                <i class="fa-solid fa-angles-down fa-beat" style="color: #ffffff;"></i>
              </div>
            </a>
          </div>
        </div>

        <div class="col">
          <div class="pt-4">
            <h2 class="fw-bold fs-3 mb-3">アプリの使い方</h2>
          </div>
          <div class="row row-cols-1 pt-3">
            <div class="col d-flex flex-column align-items-center">
              <div>
                <p class="fw-bold mb-1">チュートリアルでフラメンコ体験</p>
              </div>
              <div>
                <a href="#explain-tutorial">
                  <div class = "icon-container">
                    <%= image_pack_tag "media/images/icon/clap-icon.png", size: "50x50" %>
                    <div class = "icon-underlay">
                      <%= image_pack_tag "media/images/icon/base-icon.png", size: "70x10" %>
                    </div>
                    <i class="fa-solid fa-angles-down fa-beat" style="color: #ffffff;"></i>
                  </div>
                </a>
              </div>
            </div>
            
            <div class="col">
              <div class="row row-cols-2">
                <div class="col d-flex flex-column align-items-center">
                  <div>
                    <p class="fw-bold mb-1">録音する</p>
                  </div>
                  <div>
                    <a href="#explain-recording">
                      <div class = "icon-container">
                        <%= image_pack_tag "media/images/icon/recording-icon.png", size: "50x50" %>
                        <div class = "icon-underlay">
                          <%= image_pack_tag "media/images/icon/base-icon.png", size: "70x10" %>
                        </div>
                        <i class="fa-solid fa-angles-down fa-beat" style="color: #ffffff;"></i>
                      </div>
                    </a>
                  </div>
                </div>
                <div class="col d-flex flex-column align-items-center">
                  <div>
                    <p class="fw-bold mb-1">セッションする</p>
                  </div>
                  <div>
                    <a href="#explain-collab">
                      <div class="icon-container ">
                        <div class = "d-flex justify-content-center">
                          <%= image_pack_tag "media/images/icon/recording-icon.png", size: "35x45" %>
                          <%= image_pack_tag "media/images/icon/x-icon.png", size: "20x30", class: "align-self-center" %>
                          <%= image_pack_tag "media/images/icon/recording-icon.png", size: "35x45" %>
                        </div>
                        <div class = "icon-underlay">
                          <%= image_pack_tag "media/images/icon/base-icon.png", size: "70x10" %>
                        </div>
                        <i class="fa-solid fa-angles-down fa-beat" style="color: #ffffff;"></i>
                      </div>
                    </a>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<section id="introduction">
  <div class="bg-color text-white">
    <div class="text-center pt-5 pb-4">
      <h1 class="fw-bold">フラメンコってこんな音楽</h1>
    </div>
    <div class="container px-4">
      <div class="d-flex flex-column align-items-center font-monospace pb-4">
        <h2 class="fw-bold fs-3 fs-large fs-sm-xxlarge my-4">フラメンコのリズムを体験</h2>
        <div class="text-start text-sm-center">
          <div class="px-3 px-sm-0 fs-medium fs-sm-large fs-md-xlarge">
            <p>日本を代表する超絶フラメンコギターデュオを紹介します。<br>
            長年スペインで研鑽を積んできた2人が繰り広げる演奏は圧巻です。</p>
            <p class="mt-4 text-center">ギターを通してリズム・音色を感じてみましょう！</p>
          </div>
          <div class= "ratio ratio-16x9">
            <iframe src="https://www.youtube.com/embed/mNgTlL5Uik8" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>
          </div>
          <div class="text-end fs-medium fs-sm-large">
            <p>アーティスト名：<%= link_to "徳永兄弟", "https://www.tokunagaduo.com/", class: "text-white" %></p>
          </div>
        </div>
      </div>

      <div class="pb-4">
        <h2 class="text-center fw-bold font-monospace fs-3 mt-5 mb-4">フラメンコにおけるQ&A</h2>
        <div class="text-start row row-cols-1 row-cols-lg-2 g-3 g-sm-4 pb-4 mx-3 mx-sm-5">
          <div class="accordion" id="accordionExample">
            <div class="accordion-item border border-white border-4">
              <div class="accordion-header" id="panelsStayOpen-headingOne">
                <button class="accordion-button collapsed btn-outline-secondary bg-color text-white" type="button" data-bs-toggle="collapse" data-bs-target="#panelsStayOpen-collapseOne" aria-expanded="true" aria-controls="panelsStayOpen-collapseOne">
                  <h3 class="font-monospace fs-large fs-sm-xlarge">Q.どこの国の音楽？</h3>
                </button>
              </div>
              <div id="panelsStayOpen-collapseOne" class="accordion-collapse collapse" aria-labelledby="panelsStayOpen-headingOne">
                <div class="accordion-body bg-dark bg-gradient text-white border-top border-white border-4 p-4 p-md-5 fs-small fs-sm-medium fs-md-large">
                  <p class="fs-medium fs-sm-large fs-md-xlarge"><strong>A.スペインの音楽および舞踊です。</strong></p>
                  <p>歌、踊り、ギターが三位一体となって演奏されます。<br>
                  またフラメンコの起源は歌にあり、スペインでは無形文化遺産にも登録されています。</p>
                </div>
              </div>
            </div>
          </div>

          <div class="accordion" id="accordionExample">
            <div class="accordion-item border border-white border-4">
              <div class="accordion-header" id="panelsStayOpen-headingTwo">
                <button class="accordion-button collapsed btn-outline-secondary bg-color text-white" type="button" data-bs-toggle="collapse" data-bs-target="#panelsStayOpen-collapseTwo" aria-expanded="true" aria-controls="panelsStayOpen-collapseTwo">
                  <h3 class="font-monospace fs-large fs-sm-xlarge">Q.日本では有名なの？</h3>
                </button>
              </div>
              <div id="panelsStayOpen-collapseTwo" class="accordion-collapse collapse" aria-labelledby="panelsStayOpen-headingTwo">
                <div class="accordion-body bg-dark bg-gradient text-white border-top border-white border-4 p-4 p-md-5 fs-small fs-sm-medium fs-md-large">
                  <p class="fs-medium fs-sm-large fs-md-xlarge"><strong>A.日本はスペインについで、世界で2番目にフラメンコ人口が多い国です。</strong></p>
                  <p>日本のフラメンコ人口は約5万人ほどいるといわれており、<br>
                しかし比率は踊り手が80％以上、歌は15％程度、ギター5％未満と、踊り手に対して歌い手やギターリスト人口は少ない背景があります。</p>
                </div>
              </div>
            </div>
          </div>

          <div class="accordion" id="accordionExample">
            <div class="accordion-item border border-white border-4">
              <div class="accordion-header" id="panelsStayOpen-headingThree">
                <button class="accordion-button collapsed btn-outline-secondary bg-color text-white" type="button" data-bs-toggle="collapse" data-bs-target="#panelsStayOpen-collapseThree" aria-expanded="true" aria-controls="panelsStayOpen-collapseThree">
                  <h3 class="font-monospace fs-large fs-sm-xlarge">Q.どうやって参加すればいいの？</h3>
                </button>
              </div>
              <div id="panelsStayOpen-collapseThree" class="accordion-collapse collapse" aria-labelledby="panelsStayOpen-headingThree">
                <div class="accordion-body bg-dark bg-gradient text-white border-top border-white border-4 p-4 p-md-5 fs-small fs-sm-medium fs-md-large">
                  <p class="fs-medium fs-sm-large fs-md-xlarge"><strong>A.フラメンコには以下のような方法で誰でも簡単に参加ができます。</strong></p>
                  <p class="mt-4 mb-0"><strong>【ハレオ】</strong></p>
                  <p class="mb-2">アーティストを励まし、舞台を盛り上げるための掛け声・声援。（カラオケの合いの手のようなイメージ</p>
                  <p>例 olee!/オレー :「いいね！」の意味</p>
                  <p class="mt-4 mb-0"><strong>【パルマ】</strong></p>
                  <p>手拍子のこと。リズムを支える重要な役割（バンドのドラムのような）を果たしている</p>
                  <p class="mt-4">※本アプリでは<%= link_to "チュートリアル", guest_tutorial_introductions_path, class: "text-white" %>を通して実際にパルマを体験することができます。</p>
                </div>
              </div>
            </div>
          </div>

          <div class="accordion" id="accordionExample">
            <div class="accordion-item border border-white border-4">
              <div class="accordion-header" id="panelsStayOpen-headingFour">
                <button class="accordion-button collapsed btn-outline-secondary bg-color text-white" type="button" data-bs-toggle="collapse" data-bs-target="#panelsStayOpen-collapseFour" aria-expanded="true" aria-controls="panelsStayOpen-collapseFour">
                  <h3 class="font-monospace fs-large fs-sm-xlarge">Q.まだまだ認知が低いフラメンコギターとは？</h3>
                </button>
              </div>
              <div id="panelsStayOpen-collapseFour" class="accordion-collapse collapse" aria-labelledby="panelsStayOpen-headingFour">
                <div class="accordion-body bg-dark bg-gradient text-white border-top border-white border-4 p-4 p-md-5 fs-small fs-sm-medium fs-md-large">
                  <p class="fs-medium fs-sm-large fs-md-xlarge"><strong>A.日本において認知が低いフラメンコギターですが、スペインでは絶大な人気を誇っています。</strong></p>
                  <p>現代のフラメンコの世界観を彩るにはフラメンコギターは欠かせません。<br>
                  他ジャンルにはない独特な奏法・リズム・音色を演出することから、近年ではギターのみの演奏（ソロギター）も注目されています。</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      
    </div>
  </div>
</section>

<section>
  <%= render "shared/how_to_use_app" %>
</section>


