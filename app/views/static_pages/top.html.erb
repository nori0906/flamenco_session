<!-- Modal -->
<div class="modal fade" id="gusetModal" tabindex="-1" aria-labelledby="gusetModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content">
      <div class="modal-header border-0 rounded bg-dark-custom pt-2">
        <div class="bodal-body row justify-content-center text-white text-center w-100 my-4 mx-lg-5">
          <div class="col ms-lg-4">
            <h5 class="fw-medium fs-large fs-lg-larger mb-3" id="gusetModalLabel">チュートリアルを始める</h5>
            <div class="row justify-content-center">
              <%= link_to "チュートリアル", guest_tutorial_introductions_path, class: "btn btn-lg btn-custom col-8 col-sm-5 col-md-9 text-white border border-dark rounded-pill fw-semibold fs-larder fs-lg-xlarge" , type: "button" %>
            </div>
          </div>
          <div class="w-100 d-block d-md-none my-3"></div>
          <div class="col me-lg-4">
            <h5 class="fw-medium fs-large fs-lg-larger mb-3" id="gusetModalLabel">みんなの投稿を見る</h5>
            <div class="row justify-content-center">
              <%= link_to "投稿一覧", guest_index_path, class: "btn btn-lg btn-custom col-8 col-sm-5 col-md-9 text-white border border-dark rounded-pill fw-semibold fs-larder fs-lg-xlarge" , type: "button" %>
            </div>
          </div>
        </div>

        <div class="align-self-start">
          <button type="button" class="btn-close text-white" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
      </div>
    </div>
  </div>
</div>

<%# ビュー %>
<section>
  <div class="top-wrapper">
    <div class="text-white d-flex justify-content-center w-100 h-100 bkg-overlay">
      <div class="align-self-center text-center">
        <div class="pt-lg-4 pb-sm-5">
          <%# sm未満のレイアウト %>
          <div class="d-sm-none position-relative mb-4">
            <h1 class="display-1 fw-bold pb-3 mb-0" >フラッと</h1>
            <h1 class="display-1 position-absolute top-50 start-50 translate-middle fw-bold">×</h1>
            <h1 class="display-1 fw-bold pt-3" >セッション</h1>
          </div>
          <%# sm以上のレイアウト %>
          <div class="d-none d-sm-block mb-4">
            <h1 class="display-3 fw-bold" >フラッと×セッション</h1>
          </div>
          <p class="fw-medium fs-large fs-sm-larger fw-medium">フラメンコ音楽で<br class="d-block d-sm-none">繋がる・体験する・発見する</p>
        </div>
        <div class="row justify-content-center pt-4 pt-sm-1 pt-lg-4 pb-4 pb-md-4">
          <%= link_to "はじめる", posts_path, class: "col-6 col-sm-3 btn btn-custom text-white border border-dark rounded-pill fw-semibold fs-lg-xlarge py-3 mb-4 mb-sm-0 me-sm-4 me-lg-5" , type: "button", data: { bs_toggle: "modal", bs_target: "#gusetModal" } %>
          <div class="w-100 d-sm-none"></div>
          <%= link_to "ログイン", login_path, class: "col-6 col-sm-3 btn btn-custom text-white border border-dark rounded-pill fw-semibold fs-lg-xlarge py-3 ms-sm-4 ms-lg-5", type: "button" %>
        </div>
        <div class="pt-5">
          <a href="#app_overview" class="top-anchor-link"><i class="fa-solid fa-hand-point-down fa-beat castom-size"></i></a>
        </div>
      </div>
    </div>
  </div>
</section>

<section id="app_overview">
  <div class="bg-dark bg-gradient text-white pb-5">
    <div class="text-center py-5">
      <h1 class="fw-bold">フラっとセッションとは？</h1>
    </div>
    <div class="container">
      <div class="row justify-content-center">
        <div class="col-11 col-md-8 col-xl-7 col-xxl-6">
          <div class="text-start pb-1 mb-5">
