                <h2 class="border-bottom border-3 fst-italic fw-semibold fs-large fs-sm-xlarge">操作方法</h2>
              </div>
              <div class="row row-cols-1 text-center">
                <div class="col d-flex flex-column align-items-center pt-3">
                  <div>
                    <p class="fw-semibold fs-medium fs-sm-large mb-1">チュートリアル</p>
                  </div>
                  <div>
                    <a href="#explain-tutorial">
                      <div class = "icon-container">
                        <%= image_pack_tag "media/images/icon/clap-icon.png", size: "50x50" %>
                        <div class = "icon-underlay">
