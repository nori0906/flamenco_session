<div class='bg-dark bg-gradient bg-height'>
  <h1 class="text-white text-left ps-2 ps-md-5 pt-3 pb-5">ログイン</h1>
  <div class="container">
    <%= render partial: 'layouts/flash' %>
    <%= form_with url: login_path, local: true do |f| %>
      <div class="row justify-content-center text-white">
        <div class="col-11 col-sm-10 col-md-9 col-lg-7 mb-4">
          <%= f.label :email, "メールアドレス", class: "fw-bold fs-lg-larger" %>
          <%= f.text_field :email, class: 'form-control fs-lg-large py-lg-2' %>
        </div>
        <div class="col-11 col-sm-10 col-md-9 col-lg-7 mb-4">
          <%= f.label :password, "パスワード", class: "fw-bold fs-lg-larger" %>
          <%= f.password_field :password, class: 'form-control fs-lg-large py-lg-2' %>
        </div>
        <div class="col-11 col-sm-10 col-md-9 col-lg-7 mb-4">
          <%= f.submit 'ログイン', class: 'btn btn-custom text-white fw-bold fs-lg-larger px-3' %>
        </div>
        <div class='col-11 col-sm-10 col-md-9 col-lg-7 d-flex flex-column'>
          <%= link_to '登録がまだの方はこちら', new_user_path, class: "fs-lg-large mb-1" %>
          <%= link_to 'パスワードをお忘れの方はこちら', new_password_reset_path, class: "fs-lg-large" %>
        </div>
      </div>
    <% end %>
    <div class="d-flex">
    </div>
  </div>
</div>